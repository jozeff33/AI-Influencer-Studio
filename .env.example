# Local development only. Never commit the real .env file.
STUDIO_DEV_API_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://studio:studio_dev_only@db:5432/studio
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Image provider (optional; server-side only)
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1-mini
# Video provider (optional; server-side only, Runway Gen-4.5)
RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=gen4.5
# Explicit billing safety switch. Keep false during previews and tests.
ENABLE_PAID_GENERATION=false

# V0.4 story autopilot: all paid/AI switches default OFF.
STORY_AI_WRITER_ENABLED=false
STORY_TEXT_MODEL=gpt-4.1-mini
STORY_AUTO_PAID_MEDIA_ENABLED=false
STORY_WORKER_INTERVAL_SECONDS=600
